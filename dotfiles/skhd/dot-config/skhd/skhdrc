# skhdrc - keyboard hotkeys

# quick shortcuts
cmd - return : /Applications/Kitty.app/Contents/MacOS/kitty --single-instance -c ~/.config/kitty/kitty.conf -c ~/.config/kitty/darwin19.conf -d ~

# space navigation
cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6
cmd - 7 : yabai -m space --focus 7
cmd - 8 : yabai -m space --focus 8
cmd - 9 : yabai -m space --focus 9
cmd + alt - left : yabai -m space --focus prev
cmd + alt - right : yabai -m space --focus next
# space movement
cmd + ctrl - left : yabai -m space --display prev
cmd + ctrl - right : yabai -m space --display next
cmd + ctrl - 1 : yabai -m space --display 1
cmd + ctrl - 2 : yabai -m space --display 2
cmd + ctrl - 3 : yabai -m space --display 3
# create spaces
cmd + ctrl - n : yabai -m space --create
cmd + ctrl - d : yabai -m space --destroy

# display navigation
cmd + alt - 1 : yabai -m display --focus 1
cmd + alt - 2 : yabai -m display --focus 2
cmd + alt - 3 : yabai -m display --focus 3

# window navigation
cmd - left : yabai -m window --focus west
cmd - right : yabai -m window --focus east
cmd - up : yabai -m window --focus north
cmd - down : yabai -m window --focus south
# window fullscreening
# fill the display within the current space
cmd + shift - f : yabai -m window --toggle zoom-fullscreen
# macOS native fullscreen (creates a new space)
cmd + ctrl + shift - f : yabai -m window --toggle native-fullscreen
# float or tile the focused window
cmd + shift - t : yabai -m window --toggle float
# window movement
# move window around in current space
cmd + shift - right : yabai -m window --warp east
cmd + shift - left : yabai -m window --warp west
cmd + shift - up : yabai -m window --warp north
cmd + shift - down : yabai -m window --warp south
# move window to other spaces
cmd + shift - 1 : yabai -m window --space 1
cmd + shift - 2 : yabai -m window --space 2
cmd + shift - 3 : yabai -m window --space 3
cmd + shift - 4 : yabai -m window --space 4
cmd + shift - 5 : yabai -m window --space 5
cmd + shift - 6 : yabai -m window --space 6
cmd + shift - 7 : yabai -m window --space 7
cmd + shift - 8 : yabai -m window --space 8
cmd + shift - 9 : yabai -m window --space 9
# move window to other displays and follow it
cmd + shift + alt - 1 : yabai -m window --display 1; yabai -m display --focus 1
cmd + shift + alt - 2 : yabai -m window --display 2; yabai -m display --focus 2
cmd + shift + alt - 3 : yabai -m window --display 3; yabai -m display --focus 3
# switch between splitting horizontally or vertically
cmd + shift - s : yabai -m window --toggle split
# rotate the window tree in the current space
cmd + shift - r : yabai -m space --rotate 90

# resetting/refreshing yabai and friends
# restart yabai
ctrl + alt + cmd - r : launchctl kickstart -k "gui/${UID}/homebrew.mxcl.yabai"
# tidy up current space
cmd + shift - p : yabai -m space --balance

# window resizing
# the active window border turns red in 'resize' mode
:: default : borders active_color=0xc0e2e2e3
:: resize @ : borders active_color=0xffff3a30
# from 'default' mode, activate mode 'resize'
cmd - p ; resize
# from 'resize' mode, activate mode 'default'
resize < cmd - p ; default
# arrows move the edge in that direction; fall back to the opposite edge
resize < cmd - left : yabai -m window --resize left:-50:0 || yabai -m window --resize right:-50:0
resize < cmd - right : yabai -m window --resize right:50:0 || yabai -m window --resize left:50:0
resize < cmd - up : yabai -m window --resize top:0:-50 || yabai -m window --resize bottom:0:-50
resize < cmd - down : yabai -m window --resize bottom:0:50 || yabai -m window --resize top:0:50
